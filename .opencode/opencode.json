{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "Мафиози",
  "instructions": ["AGENTS.md"],
  "permission": {
    "skill": {
      "*": "deny",
      "intellisearch": "allow",
      "protocol-pravok": "allow",
      "evaluate-premortem": "allow"
    }
  },
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": ["agentmemory", "mcp"],
      "environment": {
        "AGENTMEMORY_URL": "http://localhost:3111",
        "CONSOLIDATION_ENABLED": "true"
      },
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    }
  },
  "plugin": [
    "opencode-intellisearch"
  ]
}